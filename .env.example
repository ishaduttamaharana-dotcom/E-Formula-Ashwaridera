# ============================================================
#  ASHWA RIDERS — Backend Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ============================================================

# ─── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=7d

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── CORS ───────────────────────────────────────────────────
# Frontend URL — only this origin is allowed to make API requests
CLIENT_URL=http://localhost:5173

# ─── Admin Seed ──────────────────────────────────────────────
# First-admin credentials — seeded automatically on startup if no admin exists
# Use a STRONG password meeting the password policy rules
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@ashwariders.com
ADMIN_PASSWORD=Admin@Ashwa2026!

# ─── Vercel Deployment Note ─────────────────────────────────
# When deploying to Vercel, set these same variables in the
# Vercel Project Settings > Environment Variables dashboard.
# NODE_ENV=production
# CLIENT_URL=https://your-domain.vercel.app